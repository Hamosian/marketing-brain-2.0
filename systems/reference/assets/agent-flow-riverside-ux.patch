diff --git a/web/components/agent-visualizer/canvas/camera-director.ts b/web/components/agent-visualizer/canvas/camera-director.ts
new file mode 100644
index 0000000..982a63b
--- /dev/null
+++ b/web/components/agent-visualizer/canvas/camera-director.ts
@@ -0,0 +1,155 @@
+import type { Agent, ToolCallNode } from '@/lib/agent-types'
+import { NODE } from '@/lib/agent-types'
+import { FOLLOW, MIN_VISIBLE_OPACITY, TOOL_CARD_W, TOOL_CARD_H } from '@/lib/canvas-constants'
+import type { Transform } from '@/hooks/use-canvas-camera'
+
+// ─── Camera Director ─────────────────────────────────────────────────────────
+// Follow mode picks the highest-priority live event and frames it, instead of
+// fitting the whole graph. Off-screen action should never happen silently, so
+// the priority order routes attention: needs-input first, then errors, fresh
+// spawns, running tools, thinking. Hysteresis keeps the camera from thrashing
+// between equal-priority targets.
+
+/** Lower = more urgent. */
+const PRIORITY = {
+  waiting: 0,
+  error: 1,
+  spawn: 2,
+  tool: 3,
+  thinking: 4,
+} as const
+
+export interface DirectorState {
+  targetId: string | null
+  priority: number
+  /** Sim time when the current target was locked */
+  lockedAt: number
+}
+
+export function createDirectorState(): DirectorState {
+  return { targetId: null, priority: Infinity, lockedAt: 0 }
+}
+
+interface Candidate {
+  agent: Agent
+  priority: number
+  /** Recency tie-breaker within a priority class (higher wins) */
+  freshness: number
+}
+
+function findCandidate(
+  agents: Map<string, Agent>,
+  toolCalls: Map<string, ToolCallNode>,
+  simTime: number,
+): Candidate | null {
+  // Most recent running tool start per agent — freshness for the tool class
+  const lastToolStart = new Map<string, number>()
+  for (const tc of toolCalls.values()) {
+    if (tc.state === 'running' && (lastToolStart.get(tc.agentId) ?? -Infinity) < tc.startTime) {
+      lastToolStart.set(tc.agentId, tc.startTime)
+    }
+  }
+
+  let best: Candidate | null = null
+  for (const agent of agents.values()) {
+    if (agent.opacity < MIN_VISIBLE_OPACITY) continue
+
+    let priority: number | null = null
+    let freshness = 0
+    if (agent.state === 'waiting_permission') {
+      priority = PRIORITY.waiting
+    } else if (agent.state === 'error') {
+      priority = PRIORITY.error
+    } else if (simTime - agent.spawnTime < FOLLOW.spawnRecencyS && !agent.isMain) {
+      priority = PRIORITY.spawn
+      freshness = agent.spawnTime
+    } else if (agent.state === 'tool_calling') {
+      priority = PRIORITY.tool
+      freshness = lastToolStart.get(agent.id) ?? agent.spawnTime
+    } else if (agent.state === 'thinking') {
+      priority = PRIORITY.thinking
+      freshness = agent.spawnTime
+    }
+    if (priority === null) continue
+
+    if (!best || priority < best.priority || (priority === best.priority && freshness > best.freshness)) {
+      best = { agent, priority, freshness }
+    }
+  }
+  return best
+}
+
+/**
+ * Pick (or keep) the focus target. Switches immediately for a strictly more
+ * urgent candidate; equal-priority switches wait out the dwell time.
+ */
+export function updateFocus(
+  state: DirectorState,
+  agents: Map<string, Agent>,
+  toolCalls: Map<string, ToolCallNode>,
+  simTime: number,
+): Agent | null {
+  const candidate = findCandidate(agents, toolCalls, simTime)
+
+  const current = state.targetId ? agents.get(state.targetId) : undefined
+  const currentStillQualifies = current
+    && current.opacity >= MIN_VISIBLE_OPACITY
+    && current.state !== 'complete'
+    && current.state !== 'idle'
+
+  if (!candidate) {
+    if (!currentStillQualifies) state.targetId = null
+    return currentStillQualifies ? current! : null
+  }
+
+  const dwellElapsed = simTime - state.lockedAt >= FOLLOW.minDwellS
+  const switchTarget =
+    !currentStillQualifies
+    || candidate.priority < state.priority
+    || (dwellElapsed && candidate.agent.id !== state.targetId)
+
+  if (switchTarget) {
+    state.targetId = candidate.agent.id
+    state.priority = candidate.priority
+    state.lockedAt = simTime
+    return candidate.agent
+  }
+
+  // Keep the current target but track its live priority so a downgrade
+  // (e.g. waiting -> thinking) lets more urgent candidates take over
+  if (current!.id === candidate.agent.id) state.priority = candidate.priority
+  return current!
+}
+
+/** Frame the focus agent plus its visible tool calls. */
+export function computeFollowTransform(
+  focus: Agent,
+  toolCalls: Map<string, ToolCallNode>,
+  dimensions: { width: number; height: number },
+): Transform {
+  const r = (focus.isMain ? NODE.radiusMain : NODE.radiusSub) + 30
+  let minX = focus.x - r, maxX = focus.x + r
+  let minY = focus.y - r, maxY = focus.y + r
+
+  for (const tc of toolCalls.values()) {
+    if (tc.agentId !== focus.id || tc.opacity <= 0.1) continue
+    minX = Math.min(minX, tc.x - TOOL_CARD_W / 2)
+    maxX = Math.max(maxX, tc.x + TOOL_CARD_W / 2)
+    minY = Math.min(minY, tc.y - TOOL_CARD_H / 2)
+    maxY = Math.max(maxY, tc.y + TOOL_CARD_H / 2)
+  }
+
+  const boundsW = maxX - minX + FOLLOW.padding * 2
+  const boundsH = maxY - minY + FOLLOW.padding * 2
+  const centerX = (minX + maxX) / 2
+  const centerY = (minY + maxY) / 2
+  const scale = Math.min(
+    Math.max(Math.min(dimensions.width / boundsW, dimensions.height / boundsH), FOLLOW.minScale),
+    FOLLOW.maxScale,
+  )
+  return {
+    x: dimensions.width / 2 - centerX * scale,
+    y: dimensions.height / 2 - centerY * scale,
+    scale,
+  }
+}
