diff --git a/web/hooks/use-persistent-toggle.ts b/web/hooks/use-persistent-toggle.ts
new file mode 100644
index 0000000..2ee9cdb
--- /dev/null
+++ b/web/hooks/use-persistent-toggle.ts
@@ -0,0 +1,45 @@
+'use client'
+
+import { useEffect, useRef, useState, type Dispatch, type SetStateAction } from 'react'
+
+const STORAGE_PREFIX = 'agent-flow.view.'
+
+/** useState<boolean> that survives reloads via localStorage.
+ *  The stored value is read after mount (not in the initializer) so the SSR
+ *  markup and the first client render agree; the persisted value applies one
+ *  frame later. Nothing is written until the value first changes. */
+export function usePersistentToggle(
+  key: string,
+  initial: boolean,
+): [boolean, Dispatch<SetStateAction<boolean>>] {
+  const [value, setValue] = useState(initial)
+  const skipFirstWriteRef = useRef(true)
+
+  useEffect(() => {
+    try {
+      const stored = localStorage.getItem(STORAGE_PREFIX + key)
+      if (stored !== null) setValue(stored === '1')
+    } catch { /* localStorage unavailable (private browsing, etc.) */ }
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [])
+
+  useEffect(() => {
+    if (skipFirstWriteRef.current) {
+      skipFirstWriteRef.current = false
+      return
+    }
+    try { localStorage.setItem(STORAGE_PREFIX + key, value ? '1' : '0') } catch { /* ignore */ }
+  }, [key, value])
+
+  // Cross-tab sync: storage events fire in every tab except the writer,
+  // so two open Agent Flow tabs never disagree about a preference
+  useEffect(() => {
+    const onStorage = (e: StorageEvent) => {
+      if (e.key === STORAGE_PREFIX + key && e.newValue !== null) setValue(e.newValue === '1')
+    }
+    window.addEventListener('storage', onStorage)
+    return () => window.removeEventListener('storage', onStorage)
+  }, [key])
+
+  return [value, setValue]
+}
