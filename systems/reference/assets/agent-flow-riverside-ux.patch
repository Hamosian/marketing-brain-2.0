+'use client'
+
+import { useMemo, useState } from 'react'
+import { Z } from '@/lib/agent-types'
+import type { Agent, ToolCallNode } from '@/lib/agent-types'
+import { COLORS } from '@/lib/colors'
+import { formatTokens, formatModelName } from '@/lib/utils'
+import { agentCost } from './canvas/draw-cost'
+import { PanelHeader, ProgressBar, SlidingPanel, stopPropagationHandlers } from './shared-ui'
+
+type SortKey = 'cost' | 'tokens' | 'name'
+
+interface CostPanelProps {
+  visible: boolean
+  agents: Map<string, Agent>
+  toolCalls: Map<string, ToolCallNode>
+  onClose: () => void
+}
+
+/** Interactive replacement for the canvas-drawn cost summary: a sortable,
+ *  scrollable per-agent cost table plus a by-tool breakdown. The floating
+ *  per-node cost pills stay on the canvas; this panel replaces only the
+ *  static top-right HUD, which was row-capped and not interactive. */
+export function CostPanel({ visible, agents, toolCalls, onClose }: CostPanelProps) {
+  const [sortKey, setSortKey] = useState<SortKey>('cost')
+  const [ascending, setAscending] = useState(false)
+
+  const { rows, totalTokens, totalCost, toolRows } = useMemo(() => {
+    const list = Array.from(agents.values()).filter(a => a.tokensUsed > 0)
+    const totalTokens = list.reduce((s, a) => s + a.tokensUsed, 0)
+    const rows = list.map(a => ({
+      id: a.id,
+      name: a.name,
+      model: a.model,
+      tokens: a.tokensUsed,
+      cost: agentCost(a.tokensUsed),
+      share: totalTokens > 0 ? a.tokensUsed / totalTokens : 0,
+    }))
+    rows.sort((a, b) => {
+      const cmp = sortKey === 'name' ? a.name.localeCompare(b.name) : a[sortKey] - b[sortKey]
+      return ascending ? cmp : -cmp
+    })
+
+    const byTool = new Map<string, number>()
+    for (const tc of toolCalls.values()) {
+      if (tc.tokenCost) byTool.set(tc.toolName, (byTool.get(tc.toolName) || 0) + tc.tokenCost)
+    }
+    const toolRows = Array.from(byTool.entries())
+      .map(([name, tokens]) => ({ name, tokens, cost: agentCost(tokens) }))
+      .sort((a, b) => b.cost - a.cost)
+
+    return { rows, totalTokens, totalCost: agentCost(totalTokens), toolRows }
+  }, [agents, toolCalls, sortKey, ascending])
+
+  const handleSort = (key: SortKey) => {
+    if (key === sortKey) setAscending(prev => !prev)
+    else { setSortKey(key); setAscending(key === 'name') }
+  }
+
+  if (!visible) return null
+
+  const headerCell = (key: SortKey, label: string, align: 'left' | 'right') => (
+    <button
+      onClick={() => handleSort(key)}
+      className="text-[8px] font-mono tracking-wider cursor-pointer hover:brightness-150 transition-all"
+      style={{ color: sortKey === key ? COLORS.holoBright : COLORS.textMuted, textAlign: align }}
+      title={`Sort by ${label.toLowerCase()}`}
+    >
+      {label}{sortKey === key ? (ascending ? ' ↑' : ' ↓') : ''}
+    </button>
+  )
+
+  return (
+    <SlidingPanel
+      visible={visible}
+      position={{ top: 48, right: 12 }}
+      zIndex={Z.sidePanel}
+      width={280}
+    >
+      <div className="glass-card relative" {...stopPropagationHandlers}>
+        <PanelHeader onClose={onClose}>
+          <span className="text-[10px] font-mono tracking-wider" style={{ color: COLORS.textPrimary }}>
+            COST BREAKDOWN
+          </span>
+        </PanelHeader>
+
+        {/* Totals */}
+        <div className="flex items-baseline gap-2 mb-2">
+          <span className="text-sm font-mono font-bold" style={{ color: COLORS.complete }}>
+            ${totalCost.toFixed(3)}
+          </span>
+          <span className="text-[9px] font-mono" style={{ color: COLORS.textMuted }}>
+            {formatTokens(totalTokens)} tokens · {rows.length} agents
+          </span>
+        </div>
+
+        {rows.length === 0 && (
+          <div className="text-[9px] font-mono py-2 text-center" style={{ color: COLORS.textMuted }}>
+            No token usage yet
+          </div>
+        )}
+
+        {rows.length > 0 && (
+          <>
+            {/* Sortable column headers */}
+            <div className="grid gap-1 mb-1 px-2" style={{ gridTemplateColumns: '1fr 52px 48px' }}>
+              {headerCell('name', 'AGENT', 'left')}
+              {headerCell('tokens', 'TOKENS', 'right')}
+              {headerCell('cost', 'COST', 'right')}
+            </div>
+
+            {/* Agent rows */}
+            <div className="space-y-1 max-h-[260px] overflow-y-auto">
+              {rows.map(row => (
+                <div
+                  key={row.id}
+                  className="rounded px-2 py-1.5"
+                  style={{ background: 'rgba(34, 34, 34, 0.5)', border: `1px solid ${COLORS.holoBorder06}` }}
+                >
+                  <div className="grid gap-1 items-baseline mb-1" style={{ gridTemplateColumns: '1fr 52px 48px' }}>
+                    <span className="flex items-baseline gap-1 min-w-0" title={row.model ? `${row.name} · ${row.model}` : row.name}>
+                      <span className="text-[9px] font-mono truncate" style={{ color: COLORS.textPrimary }}>
+                        {row.name}
+                      </span>
+                      {row.model && (
+                        <span className="text-[8px] font-mono shrink-0" style={{ color: COLORS.textMuted }}>
+                          {formatModelName(row.model)}
+                        </span>
+                      )}
+                    </span>
+                    <span className="text-[9px] font-mono text-right" style={{ color: COLORS.textMuted }}>
+                      {formatTokens(row.tokens)}
+                    </span>
+                    <span className="text-[9px] font-mono text-right" style={{ color: COLORS.complete }}>
+                      ${row.cost < 0.01 ? row.cost.toFixed(4) : row.cost.toFixed(3)}
+                    </span>
+                  </div>
+                  <ProgressBar percent={row.share * 100} color={COLORS.holoBase} />
+                </div>
+              ))}
+            </div>
+          </>
+        )}
+
+        {/* By-tool breakdown */}
+        {toolRows.length > 0 && (
+          <div className="mt-3">
+            <div className="text-[8px] font-mono tracking-wider mb-1" style={{ color: COLORS.textMuted }}>
+              BY TOOL
+            </div>
+            <div className="space-y-0.5 max-h-[120px] overflow-y-auto">
+              {toolRows.map(t => (
+                <div key={t.name} className="flex items-baseline justify-between px-2 py-0.5">
+                  <span className="text-[9px] font-mono truncate" style={{ color: COLORS.textPrimary }}>{t.name}</span>
+                  <span className="text-[9px] font-mono shrink-0 ml-2" style={{ color: COLORS.textMuted }}>
+                    {formatTokens(t.tokens)} · <span style={{ color: COLORS.complete }}>${t.cost < 0.01 ? t.cost.toFixed(4) : t.cost.toFixed(3)}</span>
+                  </span>
+                </div>
+              ))}
+            </div>
+          </div>
+        )}
+      </div>
+    </SlidingPanel>
+  )
+}
