diff --git a/web/lib/utils.ts b/web/lib/utils.ts
index 8697ebf..85413a5 100644
--- a/web/lib/utils.ts
+++ b/web/lib/utils.ts
@@ -12,3 +12,32 @@ export function formatTokens(tokens: number): string {
 export function truncatePath(path: string, segments = 3): string {
   return path.split('/').slice(-segments).join('/')
 }
+
+/** Compact human label for a raw model ID.
+ *  'claude-opus-4-8-20260115' → 'Opus 4.8', 'claude-fable-5' → 'Fable 5',
+ *  'gpt-5.2-codex' → 'GPT 5.2 Codex'. Unknown shapes pass through mostly as-is. */
+export function formatModelName(model: string): string {
+  const parts = model.toLowerCase()
+    .replace(/^claude-/, '')
+    .replace(/-\d{8}$/, '')   // trailing date snapshot
+    .split('-')
+  const words: string[] = []
+  let version = ''
+  for (const p of parts) {
+    if (/^[\d.]+$/.test(p)) version = version ? `${version}.${p}` : p
+    else {
+      const name = p === 'gpt' ? 'GPT' : p.charAt(0).toUpperCase() + p.slice(1)
+      if (version && words.length === 0) {
+        // Legacy version-first IDs ("claude-3-5-sonnet") — family reads first
+        words.push(name, version)
+      } else if (version) {
+        words.push(version, name)
+      } else {
+        words.push(name)
+      }
+      version = ''
+    }
+  }
+  if (version) words.push(version)
+  return words.join(' ')
+}
