+'use client'
+
+import { useEffect, useState } from 'react'
+import { Z } from '@/lib/agent-types'
+import { COLORS } from '@/lib/colors'
+import type { ConnectionStatus } from '@/lib/bridge-types'
+
+/** How long a disconnect must persist before the banner appears.
+ *  Absorbs the initial page-load handshake and momentary SSE hiccups. */
+const GRACE_MS = 3000
+
+interface ReconnectBannerProps {
+  status: ConnectionStatus
+  /** Suppressed entirely in demo mode (no relay involved) */
+  enabled: boolean
+}
+
+/** Top-center banner shown when the relay SSE connection drops.
+ *  The web app previously had no disconnect signal at all (the small
+ *  ConnectionIndicator in the top bar renders only inside VS Code), so a
+ *  relay restart just silently froze the graph. EventSource auto-reconnects,
+ *  hence "reconnecting" rather than a manual retry button. */
+export function ReconnectBanner({ status, enabled }: ReconnectBannerProps) {
+  const [show, setShow] = useState(false)
+
+  useEffect(() => {
+    if (!enabled || status !== 'disconnected') {
+      setShow(false)
+      return
+    }
+    const timer = setTimeout(() => setShow(true), GRACE_MS)
+    return () => clearTimeout(timer)
+  }, [status, enabled])
+
+  if (!show) return null
+
+  return (
+    <div
+      className="absolute left-1/2 -translate-x-1/2 glass-card flex items-center gap-2 pointer-events-none"
+      style={{ top: 48, padding: '6px 14px', zIndex: Z.contextMenu, border: `1px solid ${COLORS.error}50` }}
+    >
+      <span
+        className="w-2 h-2 rounded-full"
+        style={{ background: COLORS.error, boxShadow: `0 0 6px ${COLORS.error}`, animation: 'pulse 1.5s infinite' }}
+      />
+      <span className="text-[10px] font-mono font-semibold tracking-wider" style={{ color: COLORS.textPrimary }}>
+        RELAY DISCONNECTED
+      </span>
+      <span className="text-[10px] font-mono" style={{ color: COLORS.textMuted }}>
+        reconnecting…
+      </span>
+    </div>
+  )
+}
