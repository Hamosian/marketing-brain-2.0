+++ b/web/components/agent-visualizer/poster-export.ts
@@ -0,0 +1,173 @@
+// ─── Session Poster Export ───────────────────────────────────────────────────
+// Composes a 16:9 share card: Riverside-styled stats column on the left, the
+// live canvas (graph, trails, watermark) snapshotted on the right. Built for
+// posting a finished session to Slack or X without any editing.
+
+import { COLORS } from '@/lib/colors'
+import { POSTER } from '@/lib/canvas-constants'
+import { LOGO_PATH_DATA, LOGO_VIEWBOX } from './background-layer'
+
+export interface PosterInfo {
+  sessionLabel: string
+  dateStr: string
+  durationStr: string
+  agents: number
+  toolCalls: number
+  errors: number
+  tokensStr: string
+  costStr: string
+  models: string[]
+}
+
+const SANS = "'Instrument Sans', system-ui, sans-serif"
+const MONO = "'SF Mono', 'Fira Code', monospace"
+
+function drawLogoMark(ctx: CanvasRenderingContext2D, x: number, y: number, size: number) {
+  // First path of the brand SVG is the rounded-square logo mark (107x107 box)
+  const path = new Path2D(LOGO_PATH_DATA[0])
+  const scale = size / LOGO_VIEWBOX.height
+  ctx.save()
+  ctx.translate(x, y)
+  ctx.scale(scale, scale)
+  ctx.fillStyle = COLORS.holoBase
+  ctx.fill(path)
+  ctx.restore()
+}
+
+function statRow(
+  ctx: CanvasRenderingContext2D,
+  x: number,
+  y: number,
+  label: string,
+  value: string,
+  valueColor: string = COLORS.textPrimary,
+) {
+  ctx.font = `11px ${MONO}`
+  ctx.fillStyle = COLORS.textMuted
+  ctx.fillText(label.toUpperCase(), x, y)
+  ctx.font = `600 30px ${SANS}`
+  ctx.fillStyle = valueColor
+  ctx.fillText(value, x, y + 36)
+}
+
+export function buildSessionPoster(source: HTMLCanvasElement, info: PosterInfo): HTMLCanvasElement {
+  const s = POSTER.scale
+  const W = POSTER.width
+  const H = POSTER.height
+  const pad = POSTER.pad
+  const colW = POSTER.statsColumnW
+
+  const canvas = document.createElement('canvas')
+  canvas.width = W * s
+  canvas.height = H * s
+  const ctx = canvas.getContext('2d')!
+  ctx.scale(s, s)
+
+  // Canvas-void background
+  ctx.fillStyle = COLORS.void
+  ctx.fillRect(0, 0, W, H)
+
+  // ── Graph snapshot, right side, cover-fit into a rounded frame ────────────
+  const frameX = colW
+  const frameW = W - colW
+  const srcAspect = source.width / source.height
+  const frameAspect = frameW / H
+  let sx = 0, sy = 0, sw = source.width, sh = source.height
+  if (srcAspect > frameAspect) {
+    sw = source.height * frameAspect
+    sx = (source.width - sw) / 2
+  } else {
+    sh = source.width / frameAspect
+    sy = (source.height - sh) / 2
+  }
+  ctx.save()
+  ctx.beginPath()
+  ctx.rect(frameX, 0, frameW, H)
+  ctx.clip()
+  ctx.drawImage(source, sx, sy, sw, sh, frameX, 0, frameW, H)
+  // Fade the snapshot into the stats column so the seam reads intentional
+  const seam = ctx.createLinearGradient(frameX, 0, frameX + 160, 0)
+  seam.addColorStop(0, COLORS.void)
+  seam.addColorStop(1, COLORS.void + '00')
+  ctx.fillStyle = seam
+  ctx.fillRect(frameX, 0, 160, H)
+  ctx.restore()
+
+  // ── Stats column ───────────────────────────────────────────────────────────
+  ctx.textBaseline = 'alphabetic'
+  ctx.textAlign = 'left'
+
+  // Header: logo mark + product name
+  drawLogoMark(ctx, pad, pad, 40)
+  ctx.font = `600 17px ${SANS}`
+  ctx.fillStyle = COLORS.textPrimary
+  ctx.fillText('Riverside Agent Flow', pad + 54, pad + 20)
+  ctx.font = `11px ${MONO}`
+  ctx.fillStyle = COLORS.textMuted
+  ctx.fillText('SESSION POSTER', pad + 54, pad + 37)
+
+  // Session label + date
+  let y = pad + 116
+  ctx.font = `600 26px ${SANS}`
+  ctx.fillStyle = COLORS.textPrimary
+  const label = info.sessionLabel.length > 34 ? info.sessionLabel.slice(0, 33) + '…' : info.sessionLabel
+  ctx.fillText(label, pad, y)
+  y += 26
+  ctx.font = `12px ${MONO}`
+  ctx.fillStyle = COLORS.textMuted
+  ctx.fillText(info.dateStr, pad, y)
+
+  // Accent rule
+  y += 28
+  ctx.fillStyle = COLORS.holoBase
+  ctx.fillRect(pad, y, 46, 3)
+
+  // Stat grid: two columns
+  y += 52
+  const col2 = pad + (colW - pad * 2) / 2 + 12
+  statRow(ctx, pad, y, 'Duration', info.durationStr)
+  statRow(ctx, col2, y, 'Agents', String(info.agents))
+  y += 92
+  statRow(ctx, pad, y, 'Tool calls', String(info.toolCalls))
+  statRow(ctx, col2, y, 'Errors', String(info.errors), info.errors > 0 ? COLORS.error : COLORS.complete)
+  y += 92
+  statRow(ctx, pad, y, 'Tokens', info.tokensStr)
+  statRow(ctx, col2, y, 'Est. cost', info.costStr, COLORS.costText)
+
+  // Model chips
+  y += 78
+  ctx.font = `11px ${MONO}`
+  ctx.fillStyle = COLORS.textMuted
+  ctx.fillText('MODELS', pad, y)
+  y += 12
+  let chipX = pad
+  ctx.font = `12px ${MONO}`
+  for (const model of info.models.slice(0, 4)) {
+    const w = ctx.measureText(model).width + 22
+    if (chipX + w > colW - pad) break
+    ctx.fillStyle = COLORS.holoBg10
+    ctx.strokeStyle = COLORS.glassBorder
+    ctx.beginPath()
+    ctx.roundRect(chipX, y, w, 26, 13)
+    ctx.fill()
+    ctx.stroke()
+    ctx.fillStyle = COLORS.holoBright
+    ctx.fillText(model, chipX + 11, y + 17)
+    chipX += w + 8
+  }
+
+  // Footer
+  ctx.font = `11px ${MONO}`
+  ctx.fillStyle = COLORS.textFaint
+  ctx.fillText('riverside.com · agent-flow', pad, H - pad + 4)
+
+  return canvas
+}
+
+export function downloadSessionPoster(source: HTMLCanvasElement, info: PosterInfo): void {
+  const poster = buildSessionPoster(source, info)
+  const a = document.createElement('a')
+  a.href = poster.toDataURL('image/png')
+  a.download = 'agent-flow-poster.png'
+  a.click()
+}
