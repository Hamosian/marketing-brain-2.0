+'use client'
+
+import { memo } from 'react'
+import { Z } from '@/lib/agent-types'
+import { COLORS } from '@/lib/colors'
+import { CloseButton, stopPropagationHandlers } from './shared-ui'
+import { formatTokens, formatModelName } from '@/lib/utils'
+import { agentCost } from './canvas/draw-cost'
+import type { SessionInfo } from '@/lib/vscode-bridge'
+import type { FleetSessionStats, FleetAgentState, FleetAttention } from '@/hooks/use-fleet-stats'
+
+// ─── Fleet View ──────────────────────────────────────────────────────────────
+// Mission-control overlay: every session as a card in a grid, sorted so the
+// ones that need attention (waiting for input, errored, stalled) come first.
+// Click a card (or press 1-9) to jump into that session. Toggled with `V`.
+// The session order is frozen by the parent when the overlay opens, so cards
+// don't reshuffle underneath the user (and 1-9 hotkeys stay trustworthy) —
+// badges and stats still update live.
+
+const BADGE: Record<FleetAttention, { label: string; color: string; pulse: boolean }> = {
+  waiting: { label: 'NEEDS INPUT', color: COLORS.waiting_permission, pulse: true },
+  error:   { label: 'ERROR',       color: COLORS.error,              pulse: true },
+  stalled: { label: 'STALLED',     color: COLORS.paused,             pulse: false },
+  running: { label: 'RUNNING',     color: COLORS.holoBase,           pulse: false },
+  done:    { label: 'DONE',        color: COLORS.complete,           pulse: false },
+}
+
+const AGENT_STATE_COLOR: Record<FleetAgentState, string> = {
+  running: COLORS.holoBase,
+  tool: COLORS.tool_calling,
+  waiting: COLORS.waiting_permission,
+  error: COLORS.error,
+  complete: COLORS.complete,
+  idle: COLORS.holoBase + '55',
+}
+
+function formatAgo(ms: number): string {
+  const s = Math.max(0, Math.floor(ms / 1000))
+  if (s < 60) return `${s}s ago`
+  const m = Math.floor(s / 60)
+  if (m < 60) return `${m}m ago`
+  return `${Math.floor(m / 60)}h ago`
+}
+
+// ─── Mini Graph ──────────────────────────────────────────────────────────────
+// Schematic session shape: main agent centered, subagents on a ring, each dot
+// colored by live state. Derived from aggregates — no physics, no canvas.
+
+const MINI = { size: 84, ringRadius: 28, maxSubs: 10 }
+
+function MiniGraph({ stats }: { stats: FleetSessionStats }) {
+  const c = MINI.size / 2
+  const main = stats.agents.find(a => a.isMain) ?? stats.agents[0]
+  const subs = stats.agents.filter(a => a !== main)
+  const shown = subs.slice(0, MINI.maxSubs)
+  const overflow = subs.length - shown.length
+
+  return (
+    <svg width={MINI.size} height={MINI.size} className="shrink-0">
+      {shown.map((agent, i) => {
+        const angle = (i / shown.length) * Math.PI * 2 - Math.PI / 2
+        const x = c + Math.cos(angle) * MINI.ringRadius
+        const y = c + Math.sin(angle) * MINI.ringRadius
+        const color = AGENT_STATE_COLOR[agent.state]
+        return (
+          <g key={agent.name}>
+            <line x1={c} y1={c} x2={x} y2={y} stroke={COLORS.holoBorder10} strokeWidth={1} />
+            <circle cx={x} cy={y} r={4} fill={color}>
+              {agent.state === 'waiting' && (
+                <animate attributeName="opacity" values="1;0.3;1" dur="1.5s" repeatCount="indefinite" />
+              )}
+            </circle>
+          </g>
+        )
+      })}
+      {main && (
+        <circle cx={c} cy={c} r={7} fill={AGENT_STATE_COLOR[main.state]} stroke={COLORS.void} strokeWidth={1.5}>
+          {main.state === 'waiting' && (
+            <animate attributeName="opacity" values="1;0.3;1" dur="1.5s" repeatCount="indefinite" />
+          )}
+        </circle>
+      )}
+      {overflow > 0 && (
+        <text x={MINI.size - 2} y={MINI.size - 3} textAnchor="end" fontSize={9} fontFamily="monospace" fill={COLORS.textFaint}>
+          +{overflow}
+        </text>
+      )}
+      {!main && (
+        <text x={c} y={c + 3} textAnchor="middle" fontSize={9} fontFamily="monospace" fill={COLORS.textFaint}>
+          no agents
+        </text>
+      )}
+    </svg>
+  )
+}
+
+// ─── Session Card ────────────────────────────────────────────────────────────
+
+function SessionCard({ session, stats, isSelected, hotkey, onSelect }: {
+  session: SessionInfo
+  stats: FleetSessionStats | undefined
+  isSelected: boolean
+  hotkey: number | null
+  onSelect: (id: string) => void
+}) {
+  const attention = stats?.attention ?? (session.status === 'completed' ? 'done' : 'running')
+  const badge = BADGE[attention]
+  const startedAt = new Date(session.startTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
+  const needsAttention = attention === 'waiting' || attention === 'error'
+
+  // Say what it needs, not just that it needs something (direct encoding)
+  const attentionReason = attention === 'waiting'
+    ? (stats?.waitingReason ?? 'Waiting for input')
+    : attention === 'error' && stats?.lastError
+    ? `${stats.lastError.tool}: ${stats.lastError.message ?? 'failed'}`
+    : null
+
+  return (
+    <button
+      onClick={() => onSelect(session.id)}
+      title={`${session.label}${attentionReason ? `\n${attentionReason}` : ''}\nStarted ${startedAt} — click to open`}
+      className="text-left rounded-lg p-3 transition-all cursor-pointer hover:brightness-125 flex flex-col gap-2"
+      style={{
+        background: isSelected ? COLORS.tabSelectedBg : COLORS.holoBg05,
+        border: `1px solid ${needsAttention ? badge.color + '80' : isSelected ? COLORS.tabSelectedBorder : COLORS.holoBorder10}`,
+      }}
+    >
+      {/* Header: badge + hotkey */}
+      <div className="flex items-center justify-between gap-2">
+        <span className="flex items-center gap-1.5 text-[9px] font-mono font-semibold tracking-wider" style={{ color: badge.color }}>
+          <span
+            className="inline-block w-1.5 h-1.5 rounded-full"
+            style={{
+              background: badge.color,
+              boxShadow: `0 0 4px ${badge.color}`,
+              animation: badge.pulse ? 'pulse 1.5s infinite' : 'none',
+            }}
+          />
+          {badge.label}
+        </span>
+        {hotkey !== null && (
+          <kbd
+            className="inline-flex items-center justify-center w-4 h-4 rounded text-[9px] font-mono"
+            style={{ background: COLORS.holoBg10, border: `1px solid ${COLORS.toggleBorder}`, color: COLORS.textMuted }}
+          >
+            {hotkey}
+          </kbd>
+        )}
+      </div>
+
+      {/* Label */}
+      <div className="text-[11px] font-mono truncate" style={{ color: COLORS.textPrimary }}>
+        {session.label}
+      </div>
+
+      {/* Attention reason — what the session is blocked on or what failed */}
+      {attentionReason && (
+        <div className="text-[10px] font-mono truncate" style={{ color: badge.color }}>
+          {attentionReason}
+        </div>
+      )}
+
+      {/* Mini graph + stats */}
+      <div className="flex items-center gap-3">
+        {stats ? <MiniGraph stats={stats} /> : <div style={{ width: MINI.size, height: MINI.size }} />}
+        <div className="flex flex-col gap-1 text-[10px] font-mono min-w-0" style={{ color: COLORS.textMuted }}>
+          <span>{stats ? `${stats.activeAgents}/${stats.agents.length} agents` : '—'}</span>
+          <span>
+            {stats?.toolCalls ?? 0} tools
+            {stats && stats.errors > 0 && (
+              <span style={{ color: COLORS.error, marginLeft: 4 }}>{stats.errors} err</span>
+            )}
+          </span>
+          <span>
+            {formatTokens(stats?.tokens ?? 0)} tok
+            <span style={{ color: COLORS.costTextDim, marginLeft: 4 }}>
+              ~${agentCost(stats?.tokens ?? 0).toFixed(2)}
+            </span>
+          </span>
+          {stats?.model && (
+            <span className="truncate" style={{ color: COLORS.holoBright }}>{formatModelName(stats.model)}</span>
+          )}
+        </div>
+      </div>
+
+      {/* Footer */}
+      <div className="flex items-center justify-between text-[9px] font-mono" style={{ color: COLORS.textFaint }}>
+        <span>started {startedAt}</span>
+        <span>{stats ? formatAgo(Date.now() - stats.lastEventAt) : ''}</span>
+      </div>
+    </button>
+  )
+}
+
+// ─── Overlay ─────────────────────────────────────────────────────────────────
+
+export const FleetView = memo(function FleetView({
+  visible, sessions, stats, selectedSessionId, onSelect, onClose,
+}: {
+  visible: boolean
+  /** Pre-ordered by the parent (frozen at overlay open) — rendered as-is */
+  sessions: SessionInfo[]
+  stats: Map<string, FleetSessionStats>
+  selectedSessionId: string | null
+  onSelect: (sessionId: string) => void
+  onClose: () => void
+}) {
+  if (!visible) return null
+
+  const activeCount = sessions.filter(s => s.status === 'active').length
+
+  return (
+    <div
+      className="absolute inset-0 flex items-center justify-center"
+      style={{ zIndex: Z.contextMenu, background: 'rgba(0,0,0,0.45)' }}
+      onClick={onClose}
+    >
+      <div
+        {...stopPropagationHandlers}
+        className="glass-card flex flex-col"
+        style={{ width: 720, maxWidth: '94vw', maxHeight: '84vh', padding: 20 }}
+      >
+        {/* Header */}
+        <div className="flex items-center justify-between mb-4">
+          <span className="text-xs font-mono font-semibold tracking-wider uppercase" style={{ color: COLORS.textPrimary }}>
+            Fleet
+            <span style={{ color: COLORS.textMuted, marginLeft: 8, fontWeight: 400 }}>
+              {sessions.length} session{sessions.length === 1 ? '' : 's'} · {activeCount} active
+            </span>
+          </span>
+          <CloseButton onClick={onClose} />
+        </div>
+
+        {/* Grid */}
+        {sessions.length === 0 ? (
+          <div className="py-12 text-center text-[11px] font-mono" style={{ color: COLORS.textMuted }}>
+            No sessions yet — start a Claude Code session to populate the fleet
+          </div>
+        ) : (
+          <div
+            className="grid gap-3 overflow-y-auto pr-1"
+            style={{ gridTemplateColumns: 'repeat(auto-fill, minmax(300px, 1fr))' }}
+          >
+            {sessions.map((session, i) => (
+              <SessionCard
+                key={session.id}
+                session={session}
+                stats={stats.get(session.id)}
+                isSelected={session.id === selectedSessionId}
+                hotkey={i < 9 ? i + 1 : null}
+                onSelect={onSelect}
+              />
+            ))}
+          </div>
+        )}
+
+        {/* Footer hint */}
+        <div
+          className="mt-4 pt-3 text-[10px] font-mono text-center"
+          style={{ borderTop: `1px solid ${COLORS.panelSeparator}`, color: COLORS.textFaint }}
+        >
+          <span style={{ color: COLORS.textMuted }}>1–9</span> open a session ·{' '}
+          <span style={{ color: COLORS.textMuted }}>V</span> or{' '}
+          <span style={{ color: COLORS.textMuted }}>Esc</span> to close
+        </div>
+      </div>
+    </div>
+  )
+})
