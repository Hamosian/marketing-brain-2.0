+'use client'
+
+import { useEffect, useRef, useState } from 'react'
+import type { SimulationEvent } from '@/lib/agent-types'
+import type { SessionInfo } from '@/lib/vscode-bridge'
+
+// ─── Fleet Stats ─────────────────────────────────────────────────────────────
+// Lightweight per-session aggregates for the fleet view. The simulation engine
+// only runs for the selected session, so fleet cards are driven by a cheap
+// incremental reduction over the bridge's per-session event buffers instead of
+// N full simulations. Polled at 1Hz; each tick only consumes events that
+// arrived since the previous tick.
+
+export type FleetAttention = 'waiting' | 'error' | 'stalled' | 'running' | 'done'
+
+export type FleetAgentState = 'running' | 'tool' | 'waiting' | 'error' | 'complete' | 'idle'
+
+export interface FleetAgentInfo {
+  name: string
+  isMain: boolean
+  parent?: string
+  model?: string
+  state: FleetAgentState
+  /** Why the agent is waiting (from the permission notification), while state === 'waiting' */
+  waitingReason?: string
+}
+
+export interface FleetSessionStats {
+  sessionId: string
+  agents: FleetAgentInfo[]
+  activeAgents: number
+  toolCalls: number
+  errors: number
+  tokens: number
+  /** Model of the main agent (fallback: first agent with a model) */
+  model?: string
+  attention: FleetAttention
+  /** Wall-clock ms of the last observed event (poll-time approximation) */
+  lastEventAt: number
+  /** What the session is blocked on, when attention === 'waiting' */
+  waitingReason?: string
+  /** Most recent tool failure, surfaced when attention === 'error' */
+  lastError?: { tool: string; message?: string }
+}
+
+/** An active session with no new events for this long is flagged stalled. */
+const STALL_THRESHOLD_MS = 120_000
+const POLL_MS = 1000
+
+/** Lower rank = needs attention sooner. Drives fleet sort order. */
+const ATTENTION_RANK: Record<FleetAttention, number> = {
+  waiting: 0,
+  error: 1,
+  stalled: 2,
+  running: 3,
+  done: 4,
+}
+
+/** Sessions ordered by attention priority, then most recent activity. */
+export function sortFleetSessions(
+  sessions: SessionInfo[],
+  stats: Map<string, FleetSessionStats>,
+): SessionInfo[] {
+  return [...sessions].sort((a, b) => {
+    const sa = stats.get(a.id)
+    const sb = stats.get(b.id)
+    const ra = sa ? ATTENTION_RANK[sa.attention] : ATTENTION_RANK.running
+    const rb = sb ? ATTENTION_RANK[sb.attention] : ATTENTION_RANK.running
+    if (ra !== rb) return ra - rb
+    return (sb?.lastEventAt ?? b.lastActivityTime) - (sa?.lastEventAt ?? a.lastActivityTime)
+  })
+}
+
+interface SessionAgg {
+  consumed: number
+  agents: Map<string, FleetAgentInfo>
+  toolCalls: number
+  errors: number
+  tokensByAgent: Map<string, number>
+  lastError?: { tool: string; message?: string }
+  lastEventAt: number
+  /** False until the first poll has consumed the pre-existing event buffer.
+   *  The historical backlog must not count as fresh activity, or an
+   *  already-idle session would read RUNNING for a full stall threshold. */
+  initialized: boolean
+}
+
+function str(v: unknown, fallback = ''): string {
+  return typeof v === 'string' ? v : fallback
+}
+
+/** Mirrors the simulation's event handlers (see hooks/simulation/) at the
+ *  fidelity the fleet needs: agent roster + states, tool counts, tokens. */
+function reduceEvent(agg: SessionAgg, event: SimulationEvent): void {
+  const p = event.payload
+  const setAgentState = (name: string, state: FleetAgentState) => {
+    const agent = agg.agents.get(name)
+    if (agent && agent.state !== 'complete') {
+      // Leaving 'waiting' clears the blocked-on reason
+      agg.agents.set(name, { ...agent, state, ...(state !== 'waiting' ? { waitingReason: undefined } : {}) })
+    }
+  }
+  switch (event.type) {
+    case 'agent_spawn': {
+      const name = str(p.name)
+      if (!name) break
+      agg.agents.set(name, {
+        name,
+        isMain: p.isMain === true,
+        parent: typeof p.parent === 'string' ? p.parent : undefined,
+        model: typeof p.model === 'string' ? p.model : undefined,
+        state: 'running',
+      })
+      break
+    }
+    case 'agent_complete':
+      setAgentState(str(p.name), 'complete')
+      break
+    case 'agent_idle': {
+      // Same guard as the simulation: only tool/waiting agents drop to idle
+      const agent = agg.agents.get(str(p.name))
+      if (agent && (agent.state === 'tool' || agent.state === 'waiting')) {
+        agg.agents.set(agent.name, { ...agent, state: 'idle' })
+      }
+      break
+    }
+    case 'model_detected': {
+      const agent = agg.agents.get(str(p.agent))
+      if (agent) agg.agents.set(agent.name, { ...agent, model: str(p.model) || agent.model })
+      break
+    }
+    case 'tool_call_start':
+      setAgentState(str(p.agent), 'tool')
+      break
+    case 'tool_call_end': {
+      agg.toolCalls++
+      const isError = p.isError === true
+      if (isError) {
+        agg.errors++
+        agg.lastError = {
+          tool: str(p.tool, 'tool'),
+          message: typeof p.errorMessage === 'string' ? p.errorMessage : undefined,
+        }
+      }
+      setAgentState(str(p.agent), isError ? 'error' : 'running')
+      break
+    }
+    case 'message': {
+      // Any message is activity — a waiting agent is no longer blocked
+      const agent = agg.agents.get(str(p.agent))
+      if (agent && agent.state === 'waiting') {
+        agg.agents.set(agent.name, { ...agent, state: 'running' })
+      }
+      break
+    }
+    case 'context_update': {
+      const name = str(p.agent)
+      const tokens = typeof p.tokens === 'number' ? p.tokens : undefined
+      if (name && tokens !== undefined) agg.tokensByAgent.set(name, tokens)
+      break
+    }
+    case 'permission_requested': {
+      // Same default as the simulation's handler
+      const name = str(p.agent, 'Orchestrator')
+      const agent = agg.agents.get(name)
+        ?? Array.from(agg.agents.values()).find(a => a.isMain)
+      if (agent) {
+        setAgentState(agent.name, 'waiting')
+        // Encode what it needs directly in the alert, not just that it needs it
+        const reason = str(p.message) || str(p.title)
+        const updated = agg.agents.get(agent.name)
+        if (updated && updated.state === 'waiting' && reason) {
+          agg.agents.set(agent.name, { ...updated, waitingReason: reason })
+        }
+      }
+      break
+    }
+  }
+}
+
+function computeStats(session: SessionInfo, agg: SessionAgg, now: number): FleetSessionStats {
+  const agents = Array.from(agg.agents.values())
+  let tokens = 0
+  for (const t of agg.tokensByAgent.values()) tokens += t
+
+  const waitingAgent = agents.find(a => a.state === 'waiting')
+  const anyError = agents.some(a => a.state === 'error')
+  const attention: FleetAttention =
+    session.status === 'completed' ? 'done'
+    : waitingAgent ? 'waiting'
+    : anyError ? 'error'
+    : now - agg.lastEventAt > STALL_THRESHOLD_MS ? 'stalled'
+    : 'running'
+
+  return {
+    sessionId: session.id,
+    agents,
+    activeAgents: agents.filter(a => a.state === 'running' || a.state === 'tool' || a.state === 'waiting').length,
+    toolCalls: agg.toolCalls,
+    errors: agg.errors,
+    tokens,
+    model: agents.find(a => a.isMain && a.model)?.model ?? agents.find(a => a.model)?.model,
+    attention,
+    lastEventAt: agg.lastEventAt,
+    waitingReason: waitingAgent?.waitingReason,
+    lastError: agg.lastError,
+  }
+}
+
+export function useFleetStats({
+  sessions,
+  getSessionEvents,
+  fleetVisible,
+}: {
+  sessions: SessionInfo[]
+  getSessionEvents: (sessionId: string) => readonly SimulationEvent[]
+  fleetVisible: boolean
+}): { stats: Map<string, FleetSessionStats>; attentionCount: number } {
+  const [stats, setStats] = useState<Map<string, FleetSessionStats>>(new Map())
+  const aggsRef = useRef<Map<string, SessionAgg>>(new Map())
+  const fingerprintRef = useRef('')
+
+  // Latest inputs in refs so the poll interval never needs re-subscribing
+  const sessionsRef = useRef(sessions)
+  sessionsRef.current = sessions
+  const getEventsRef = useRef(getSessionEvents)
+  getEventsRef.current = getSessionEvents
+  const visibleRef = useRef(fleetVisible)
+  visibleRef.current = fleetVisible
+
+  useEffect(() => {
+    const tick = () => {
+      const now = Date.now()
+      const next = new Map<string, FleetSessionStats>()
+      const fingerprint: string[] = []
+
+      for (const session of sessionsRef.current) {
+        let agg = aggsRef.current.get(session.id)
+        if (!agg) {
+          agg = {
+            consumed: 0,
+            agents: new Map(),
+            toolCalls: 0,
+            errors: 0,
+            tokensByAgent: new Map(),
+            lastEventAt: session.lastActivityTime,
+            initialized: false,
+          }
+          aggsRef.current.set(session.id, agg)
+        }
+        const events = getEventsRef.current(session.id)
+        if (events.length > agg.consumed) {
+          for (let i = agg.consumed; i < events.length; i++) reduceEvent(agg, events[i])
+          agg.consumed = events.length
+          // Only events that arrived after the first poll are fresh activity;
+          // the initial historical buffer keeps the session.lastActivityTime
+          // seed so stall detection isn't reset by merely opening the page
+          if (agg.initialized) agg.lastEventAt = now
+        }
+        agg.initialized = true
+        const s = computeStats(session, agg, now)
+        next.set(session.id, s)
+        fingerprint.push(`${session.id}:${agg.consumed}:${s.attention}`)
+      }
+
+      // Drop aggregates for sessions that were closed
+      for (const id of aggsRef.current.keys()) {
+        if (!next.has(id)) aggsRef.current.delete(id)
+      }
+
+      // Re-render only when something changed — except while the fleet is
+      // open, where the relative "ago" labels need a tick each second
+      const fp = fingerprint.join('|')
+      if (fp !== fingerprintRef.current || visibleRef.current) {
+        fingerprintRef.current = fp
+        setStats(next)
+      }
+    }
+
+    tick()
+    const id = setInterval(tick, POLL_MS)
+    return () => clearInterval(id)
+  }, [])
+
+  let attentionCount = 0
+  for (const s of stats.values()) {
+    if (s.attention === 'waiting' || s.attention === 'error') attentionCount++
+  }
+
+  return { stats, attentionCount }
+}
diff --git a/web/hooks/use-highlight-export.ts b/web/hooks/use-highlight-export.ts
new file mode 100644
index 0000000..51a9c2c
--- /dev/null
+++ b/web/hooks/use-highlight-export.ts
@@ -0,0 +1,192 @@
+'use client'
+
+import { useCallback, useEffect, useRef, useState, type MutableRefObject } from 'react'
+import type { TimelineEvent } from '@/lib/agent-types'
+import { HIGHLIGHT } from '@/lib/canvas-constants'
+
+// ─── Auto-Highlight Export ───────────────────────────────────────────────────
+// One click picks the most eventful stretch of the session, replays it with
+// the camera director driving, records the canvas, and downloads a short
+// video. The demo-craft research is specific: the first seconds must show the
+// wow moment and clips should stay in the 10-15s range — so the window is
+// chosen by event weight (errors loudest), not "the beginning".
+
+/** Most eventful [start, end] window of `windowS` sim-seconds. */
+export function pickHighlightWindow(
+  events: TimelineEvent[],
+  maxTime: number,
+  windowS: number = HIGHLIGHT.windowS,
+): { start: number; end: number } {
+  const end = Math.max(maxTime, 0.001)
+  if (events.length === 0 || end <= windowS) {
+    return { start: 0, end: Math.min(windowS, end) }
+  }
+  let best = 0
+  let bestScore = -1
+  let lo = 0
+  let score = 0
+  const weight = (e: TimelineEvent) => HIGHLIGHT.weights[e.type] ?? 1
+  for (let hi = 0; hi < events.length; hi++) {
+    score += weight(events[hi])
+    while (events[hi].timestamp - events[lo].timestamp > windowS) {
+      score -= weight(events[lo])
+      lo++
+    }
+    if (score > bestScore) {
+      bestScore = score
+      best = events[lo].timestamp
+    }
+  }
+  const start = Math.max(0, Math.min(best - 0.5, end - windowS))
+  return { start, end: start + windowS }
+}
+
+function pickMimeType(): string | null {
+  if (typeof MediaRecorder === 'undefined') return null
+  for (const mime of HIGHLIGHT.mimeCandidates) {
+    if (MediaRecorder.isTypeSupported(mime)) return mime
+  }
+  return null
+}
+
+interface HighlightExportOptions {
+  timelineEvents: TimelineEvent[]
+  currentTime: number
+  maxTimeReached: number
+  isPlaying: boolean
+  isReviewing: boolean
+  followMode: boolean
+  play: () => void
+  pause: () => void
+  seekToTime: (t: number) => void
+  setSpeed: (s: number) => void
+  speed: number
+  setFollowMode: (v: boolean) => void
+  setIsReviewing: (v: boolean) => void
+  /** Suppresses audio retriggering during programmatic seeks */
+  seekingRef: MutableRefObject<boolean>
+  /** Resume-live handler from the app (seek to head + play) */
+  onResumeLive: () => void
+}
+
+export function useHighlightExport(opts: HighlightExportOptions) {
+  const optsRef = useRef(opts)
+  optsRef.current = opts
+
+  const [isCapturing, setIsCapturing] = useState(false)
+  // Detected after mount (SSR-safe). When recording isn't supported the
+  // export entry points hide rather than silently doing nothing.
+  const [captureSupported, setCaptureSupported] = useState(true)
+  useEffect(() => { setCaptureSupported(pickMimeType() !== null) }, [])
+  const captureRef = useRef<{
+    endTime: number
+    recorder: MediaRecorder
+    chunks: Blob[]
+    prev: { wasPlaying: boolean; wasReviewing: boolean; time: number; speed: number; follow: boolean }
+    safetyTimer: ReturnType<typeof setTimeout>
+    stopped: boolean
+  } | null>(null)
+
+  const finishCapture = useCallback(() => {
+    const cap = captureRef.current
+    if (!cap || cap.stopped) return
+    cap.stopped = true
+    clearTimeout(cap.safetyTimer)
+    if (cap.recorder.state !== 'inactive') cap.recorder.stop()
+  }, [])
+
+  const startCapture = useCallback(() => {
+    const o = optsRef.current
+    if (captureRef.current) return
+    const canvas = document.querySelector('canvas')
+    if (!canvas) return
+    const mime = pickMimeType()
+    if (!mime) return
+
+    const { start, end } = pickHighlightWindow(o.timelineEvents, o.maxTimeReached)
+    const prev = {
+      wasPlaying: o.isPlaying,
+      wasReviewing: o.isReviewing,
+      time: o.currentTime,
+      speed: o.speed,
+      follow: o.followMode,
+    }
+
+    // Rewind to the window start with the director driving
+    o.pause()
+    o.setIsReviewing(true)
+    o.setFollowMode(true)
+    o.seekingRef.current = true
+    o.seekToTime(start)
+    o.setSpeed(HIGHLIGHT.speed)
+
+    const stream = canvas.captureStream(HIGHLIGHT.fps)
+    const recorder = new MediaRecorder(stream, { mimeType: mime })
+    const chunks: Blob[] = []
+    recorder.ondataavailable = (e) => { if (e.data.size > 0) chunks.push(e.data) }
+    recorder.onstop = () => {
+      for (const track of stream.getTracks()) track.stop()
+      const container = mime.split(';')[0]
+      const blob = new Blob(chunks, { type: container })
+      if (blob.size > 0) {
+        const url = URL.createObjectURL(blob)
+        const a = document.createElement('a')
+        a.href = url
+        a.download = `agent-flow-highlight.${container.split('/')[1]}`
+        a.click()
+        setTimeout(() => URL.revokeObjectURL(url), 10_000)
+      }
+
+      // Restore where the user was
+      const r = optsRef.current
+      r.pause()
+      r.setSpeed(prev.speed)
+      r.setFollowMode(prev.follow)
+      if (!prev.wasReviewing) {
+        r.onResumeLive()
+      } else {
+        r.seekingRef.current = true
+        r.seekToTime(prev.time)
+        setTimeout(() => { optsRef.current.seekingRef.current = false }, 100)
+      }
+      captureRef.current = null
+      setIsCapturing(false)
+    }
+
+    const expectedMs = ((end - start) / HIGHLIGHT.speed) * 1000
+    const safetyTimer = setTimeout(finishCapture, expectedMs + HIGHLIGHT.settleMs + HIGHLIGHT.safetyMs)
+    captureRef.current = { endTime: end, recorder, chunks, prev, safetyTimer, stopped: false }
+    setIsCapturing(true)
+
+    // Let the seek snap and the director fly in before frames start
+    setTimeout(() => {
+      const cap = captureRef.current
+      if (!cap || cap.stopped) return
+      optsRef.current.seekingRef.current = false
+      cap.recorder.start(250)
+      optsRef.current.play()
+    }, HIGHLIGHT.settleMs)
+  }, [finishCapture])
+
+  // Stop when playback crosses the window end
+  useEffect(() => {
+    const cap = captureRef.current
+    if (cap && !cap.stopped && opts.currentTime >= cap.endTime) finishCapture()
+  }, [opts.currentTime, finishCapture])
+
+  // Abandon cleanly on unmount
+  useEffect(() => () => {
+    const cap = captureRef.current
+    if (cap) {
+      cap.stopped = true
+      clearTimeout(cap.safetyTimer)
+      if (cap.recorder.state !== 'inactive') {
+        cap.recorder.onstop = null
+        cap.recorder.stop()
+      }
+      captureRef.current = null
+    }
+  }, [])
+
+  return { isCapturing, captureSupported, startCapture }
+}
