// Routing eval suite. One JSON object per line: {"request", "expect", "why"}.
// `request` is phrased the way someone would actually ask. `expect` is the frontmatter
// `name:` of the skill that should own it. `why` says what near-miss the case guards, and
// is the field that makes a failure diagnosable six months from now.
// Read by scripts/eval_routing.py (deterministic) and /skill-eval (model-in-the-loop).
// Adding cases: evals/README.md. Design: docs/skill-evals.md.

// --- Daily briefs: three skills, three altitudes, one vocabulary ---
{"request": "good morning, catch me up on what happened overnight", "expect": "good-morning", "why": "individual morning brief, not the director-level or shared-MOPs variant"}
{"request": "what needs Nir's attention today, decisions first", "expect": "chief-of-staff", "why": "director altitude: decisions and org pulse, not a task list"}
{"request": "run the shared standup for me and Jonathan across the MOPs and website boards", "expect": "mops-standup", "why": "two-owner split by board, distinct from good-morning"}
{"request": "show me the team tasks dashboard by function with open and overdue counts", "expect": "growth-marketing-team-tasks", "why": "interactive dashboard, the visual companion to chief-of-staff"}

// --- Nir's report library: cadence is the only discriminator ---
{"request": "build Nir's weekly task report doc for last week", "expect": "nir-weekly-report", "why": "weekly vs monthly sibling; near-identical descriptions apart from cadence"}
{"request": "generate the monthly task report for Nir covering June", "expect": "nir-monthly-report", "why": "monthly .docx sibling of nir-weekly-report"}
{"request": "send Nir today's inbound MQL digest of demo bookers", "expect": "nir-mql-live-report", "why": "daily MQL DM, not a task report and not the demo-reply drafting flow"}

// --- MOPs board lifecycle ---
{"request": "audit the backlog and on-hold groups on the MOPs boards and say what to archive", "expect": "mops-backlog-review", "why": "the groups mops-standup deliberately excludes"}
{"request": "book focus slots for the P1 and P2 items I am accountable for this week", "expect": "p1-p2-followup", "why": "calendar scheduling plus nudges, not a standup"}

// --- Work intake: two boards, two taxonomies ---
{"request": "create a task for the new pricing page with a proper why and done when", "expect": "pm-story", "why": "our own board; must not go direct to the monday API"}
{"request": "ask the data team for a dashboard on signup attribution", "expect": "data-team-request", "why": "different board, different taxonomy; the classic pm-story confusion"}
{"request": "update the status of these five items on the marketing operations board", "expect": "monday-agent", "why": "read/update work state, not story writing"}

// --- QA: same checklist grammar, different surface ---
{"request": "QA this HubSpot nurture workflow before we turn it on", "expect": "hubspot-workflow-qa", "why": "workflow QA sibling of the web-page QA skill"}
{"request": "review the new comparison page on staging before we launch it", "expect": "marketing-website-page-qa", "why": "page QA sibling of hubspot-workflow-qa"}

// --- Design: color/type vs behaviour/structure ---
{"request": "what are our brand colors and heading typography", "expect": "riverside-brand-guidelines", "why": "palette and type are owned here, not by the UX skill"}
{"request": "fix the spacing, hierarchy and focus states on this form", "expect": "riverside-ux-patterns", "why": "interaction and layout; the intended pair-with, not a duplicate of branding"}
{"request": "build a branded deck for the QBR", "expect": "riverside-presentation", "why": "pptx output, not general brand lookup"}

// --- Webflow: five skills over the same site ---
{"request": "build this Figma spec as a pixel-perfect responsive Webflow page", "expect": "webflow-build-agent", "why": "Data API build, not QA and not the link crawl"}
{"request": "score this Webflow page for WCAG accessibility and propose fixes", "expect": "webflow-accessibility-audit", "why": "headless audit, distinct from page QA"}
{"request": "crawl the German locale pages for 404s and redirect chains", "expect": "webflow-link-checker", "why": "link crawl, overlaps with the localization vocabulary"}
{"request": "queue the localized CMS items for the next publish", "expect": "webflow-locale-publish-queue", "why": "browser-driven publish queue, not the link checker"}
{"request": "our site images are missing alt text and half are named IMG_1234, clean them up", "expect": "webflow-asset-audit", "why": "site-wide asset library pass, not the per-page accessibility audit"}
{"request": "audit this page for missing form labels and heading structure", "expect": "webflow-accessibility-audit", "why": "element-level page audit stays here even though the alt/asset rewrite moved to webflow-asset-audit"}
{"request": "who owns riverside.com and how do we ship a page change", "expect": "website-agent", "why": "routing-layer owner; must not fall through to a specific Webflow tool skill"}

// --- Conversion: page mechanics vs behavioural science ---
{"request": "audit the homepage for conversion barriers and propose an A/B test", "expect": "page-cro", "why": "page structure and copy, not the psychology framework"}
{"request": "which cognitive biases should we lean on in this pricing copy", "expect": "marketing-psychology", "why": "behavioural models; the intended companion to page-cro"}

// --- Data and product knowledge ---
{"request": "how does AI show notes work and which plan is it on", "expect": "riverside-product-knowledge", "why": "help-center reference, not a live data question"}
{"request": "how many intro meetings did BD book last month and what converted", "expect": "preop-data-intelligence", "why": "Pre-Op data dictionary owns MQL/SQL and meeting definitions"}
{"request": "show me the calls the AEs had last week with deal context", "expect": "gong-calls-explorer", "why": "Gong plus HubSpot context, ahead of a generic Omni query"}
{"request": "refresh the organic search analytics dashboard for June", "expect": "organic-dashboard", "why": "the SEO artifact, not the SEO routing agent"}
{"request": "what was our CAC by channel in Q2", "expect": "rivermind:ask", "external": true, "why": "CLAUDE.md sends every data question to Rivermind first; a bare metric ask must not shortcut to data-agent"}
{"request": "write me ad-hoc SQL to explore the Snowflake attribution tables", "expect": "data-agent", "why": "raw SQL and table exploration is a documented direct-to-data-agent case, not a Rivermind question"}
{"request": "what counts as an MQL for us", "expect": "preop-data-intelligence", "why": "MQL/SQL definitions live in the Pre-Op dictionary, not with the measurement agent"}
{"request": "report last week's funnel performance and diagnose what moved", "expect": "measurement-agent", "why": "performance reporting and anomaly diagnosis, not raw querying"}

// --- Routing layer by domain ---
{"request": "spend is up but signups are flat, work out what is going on across paid, the site and lifecycle", "expect": "marketing-brain", "why": "spans domains; the top-level router must win over any single specialist"}
{"request": "find the contacts who booked a demo but never showed", "expect": "hubspot-agent", "why": "CRM object query"}
{"request": "design a win-back sequence for churned annual accounts", "expect": "lifecycle-agent", "why": "lifecycle journey, not a campaign launch"}
{"request": "our Google Ads CPA doubled in two weeks", "expect": "paid-acquisition-agent", "why": "paid channel health"}
{"request": "why did our AI search citations drop on the podcast pages", "expect": "seo-ai-search-agent", "why": "AI-search visibility, not the organic dashboard refresh"}
{"request": "lead routing broke, new leads are not getting assigned", "expect": "marketing-ops-automation-agent", "why": "automation breakage, not a HubSpot data pull"}
{"request": "plan the GTM launch for multitrack export", "expect": "campaign-agent", "why": "launch orchestration, not content drafting"}
{"request": "draft the newsletter copy for the feature launch", "expect": "content-agent", "why": "branded written artifact"}
{"request": "post the launch announcement in the growth channel", "expect": "slack-agent", "why": "outbound comms"}
{"request": "draft replies to yesterday's demo form submissions", "expect": "inbound-demo-reply", "why": "demo outreach drafting, distinct from the MQL digest"}

// --- Unattended routines ---
{"request": "file this month's invoice emails onto the invoices board", "expect": "invoice-inbox-to-monday", "why": "Gmail-to-monday routine"}
{"request": "welcome the collaborators who just got access to this repo", "expect": "access-welcome", "why": "collaborator onboarding DM routine"}

// --- Meta: building and maintaining the brain ---
{"request": "capture what we learned from that workflow into the repo", "expect": "retro", "why": "knowledge capture"}
{"request": "which of our docs are stale or missing fields", "expect": "health-check", "why": "repo hygiene audit, not the routing eval"}
{"request": "run the routing evals and tell me which skill descriptions collide", "expect": "skill-eval", "why": "behavioural eval, the sibling health-check does not cover"}
{"request": "interview me to fill the gaps in our knowledge base", "expect": "curious-intern", "why": "knowledge extraction interview"}
{"request": "build me a new skill for tracking competitor pricing pages", "expect": "agent-builder", "why": "authoring a skill, not running one"}
{"request": "make a Granola recipe for customer discovery calls", "expect": "granola-recipe-builder", "why": "recipe authoring; overlaps agent-builder's interview vocabulary"}
{"request": "what skills do we have and how do I trigger them", "expect": "list-skills", "why": "live listing rather than a summary from memory"}
{"request": "map the relationships between the marketing os files", "expect": "graphify", "why": "knowledge-graph query over the codebase"}
{"request": "onboard a new marketer onto this repo", "expect": "team-intro", "why": "human onboarding, not /setup and not agent-builder"}

// --- CopyTemplates: nine skills, one shared preamble ---
{"request": "give me alliteration headlines for the AI editor", "expect": "alliteration-copytemplates", "why": "single-technique skill inside a nine-skill family"}
{"request": "headlines contrasting life before and after Riverside", "expect": "antithesis-copytemplates", "why": "opposites technique"}
{"request": "use a metaphor to explain multitrack recording in a headline", "expect": "metaphor-copytemplates", "why": "familiar-explains-unfamiliar technique"}
{"request": "give the product a personality in the headline", "expect": "personification-copytemplates", "why": "single technique, easily lost among the master prompts"}
{"request": "run the humor master prompt for a batch of headlines", "expect": "humor-master-copytemplates", "why": "master prompt vs single technique"}
{"request": "run the boring but works master prompt for our headlines", "expect": "boring-but-works-master-copytemplates", "why": "master prompt"}
{"request": "headlines built around numbers and statistics", "expect": "numbers-master-copytemplates", "why": "master prompt"}
{"request": "headlines that play on a familiar phrase or saying", "expect": "phrase-play-master-copytemplates", "why": "master prompt"}
{"request": "write headlines from the customer's point of view", "expect": "point-of-view-master-copytemplates", "why": "master prompt"}

